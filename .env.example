# Copy to .env.local and fill in.
# .env.local is gitignored. Never commit a key that holds real value.

# Deployed SpeedrunEscrow instance. The frontend reads this at build time.
NEXT_PUBLIC_CONTRACT_ADDRESS=0x39b24Ab5b04FfE2ED6dC89C41462e88b302fCe1F

# Only used by scripts/seed.mjs. The frontend never touches it: browser signing
# happens inside the user's wallet.
DEPLOYER_PRIVATE_KEY=0x...
